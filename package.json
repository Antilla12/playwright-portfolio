{
  "name": "playwright-portfolio",
  "version": "1.0.0",
  "description": "Playwright end-to-end and API test automation framework, demonstrated against Wikipedia. Built as a portfolio project showcasing Page Object Model, custom fixtures, API testing, and CI/CD reporting.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.wikipedia.org"
  },
  "keywords": [
    "playwright",
    "automation",
    "e2e-testing",
    "api-testing",
    "javascript",
    "qa"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "dotenv": "^17.4.2"
  }
}
